# Copy to .env.local and fill in. Never commit real keys.
# The REACT_APP_ names match the existing Vercel project variables, so nothing on Vercel needs renaming.
# VITE_ names work too (VITE_OMDB_KEY, VITE_TMDB_KEY, VITE_GAPI_KEY) and win if both are set.

# OMDb (search + details): https://www.omdbapi.com/apikey.aspx (free, 1,000 requests/day)
REACT_APP_OMDB_KEY=
# TMDB v3 API key (trending rail + hero): https://www.themoviedb.org/settings/api (free)
REACT_APP_TMDB_KEY=
# YouTube Data API v3 key (trailer lookup): https://console.cloud.google.com/apis/library/youtube.googleapis.com (free quota)
REACT_APP_GAPI_KEY=
